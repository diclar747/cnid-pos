DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/cnidpos
# Solo en el servidor con HTTPS:
# SESSION_COOKIE_SECURE=true
# Servidor público (ver docs/despliegue.md): sin datos de ejemplo y con cuentas iniciales propias.
# SEED_SAMPLE_DATA=false
# INITIAL_ADMIN_EMAIL=admin@turestaurante.com
# INITIAL_ADMIN_PASSWORD=
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# Asistente de WhatsApp y transcripción de audios (solo en el servidor; nunca en el navegador):
# NIRO_API_KEY=niro_...
# NIRO_BASE_URL=https://niro.cnid.com.py/api/v1
# Contacto de las notificaciones push y zona horaria de estadísticas:
# VAPID_SUBJECT=mailto:soporte@turestaurante.com
# STATS_TIMEZONE=America/Asuncion
# WHATSAPP_AUTOSTART=false
